<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_CatPlus_TOBE"
                  targetNamespace="https://learn.catplus.site/bpmn/to-be">

  <bpmn:collaboration id="Collab_TOBE">
    <bpmn:participant id="Part_Customer_TB" name="Học viên &amp; Phụ huynh" processRef="Proc_Customer_TB" />
    <bpmn:participant id="Part_CatPlus_TB" name="Vận hành CatPlus (TO-BE: Human-in-the-loop + ILP)" processRef="Proc_CatPlus_TB" />
    <bpmn:participant id="Part_Tutor_TB" name="Gia sư" processRef="Proc_Tutor_TB" />

    <bpmn:messageFlow id="Msg_TB_Lead" name="Đăng ký nhu cầu học" sourceRef="Task_TB_Reg" targetRef="Start_TB_CatPlus" />
    <bpmn:messageFlow id="Msg_TB_Call" name="Gọi tư vấn chuẩn hóa (hỏi tối đa 3 slot)" sourceRef="Task_TB_CSKH_Consult" targetRef="Catch_TB_CustCall" />
    <bpmn:messageFlow id="Msg_TB_Slots" name="Cung cấp bộ 1-3 khung giờ ưu tiên" sourceRef="Task_TB_CustSlots" targetRef="Task_TB_CSKH_Consult" />
    <bpmn:messageFlow id="Msg_TB_TutorAsk" name="Gửi đề xuất ghép đã lọc trước" sourceRef="Task_TB_Mgr_Approve" targetRef="Start_TB_Tutor" />
    <bpmn:messageFlow id="Msg_TB_TutorRep" name="Xác nhận 1 chạm" sourceRef="Task_TB_TutorRep" targetRef="Catch_TB_MgrRep" />
    <bpmn:messageFlow id="Msg_TB_Confirm" name="Thông báo lịch học chính thức" sourceRef="Task_TB_CSKH_Confirm" targetRef="Catch_TB_CustConf" />
  </bpmn:collaboration>

  <!-- POOL 1: Học viên & Phụ huynh -->
  <bpmn:process id="Proc_Customer_TB" isExecutable="false">
    <bpmn:startEvent id="Start_TB_Cust" name="Phát sinh nhu cầu học" />
    <bpmn:userTask id="Task_TB_Reg" name="Gửi thông tin đăng ký" />
    <bpmn:intermediateCatchEvent id="Catch_TB_CustCall" name="Nhận cuộc gọi CSKH">
      <bpmn:messageEventDefinition id="MsgDef_TB_Call" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_TB_CustSlots" name="Chọn 1–3 khung giờ rảnh theo ưu tiên" />
    <bpmn:intermediateCatchEvent id="Catch_TB_CustConf" name="Nhận lịch học chính thức (1 vòng)">
      <bpmn:messageEventDefinition id="MsgDef_TB_Conf" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_TB_Cust" name="Sẵn sàng học thử / nhập học" />

    <bpmn:sequenceFlow id="SF_TBC1" sourceRef="Start_TB_Cust" targetRef="Task_TB_Reg" />
    <bpmn:sequenceFlow id="SF_TBC2" sourceRef="Task_TB_Reg" targetRef="Catch_TB_CustCall" />
    <bpmn:sequenceFlow id="SF_TBC3" sourceRef="Catch_TB_CustCall" targetRef="Task_TB_CustSlots" />
    <bpmn:sequenceFlow id="SF_TBC4" sourceRef="Task_TB_CustSlots" targetRef="Catch_TB_CustConf" />
    <bpmn:sequenceFlow id="SF_TBC5" sourceRef="Catch_TB_CustConf" targetRef="End_TB_Cust" />
  </bpmn:process>

  <!-- POOL 2: Vận hành CatPlus (TO-BE) -->
  <bpmn:process id="Proc_CatPlus_TB" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TB">
      <bpmn:lane id="Lane_TB_CSKH" name="Chăm sóc khách hàng (CSKH)">
        <bpmn:flowNodeRef>Start_TB_CatPlus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TB_CSKH_Consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TB_CSKH_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TB_Lost</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TB_Manager" name="Quản lý học vụ (Human Approval)">
        <bpmn:flowNodeRef>GW_TB_HasCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TB_Mgr_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_TB_MgrRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_TB_TutorOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TB_Mgr_Fallback</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TB_System" name="Hệ thống CatPlus + Module ILP">
        <bpmn:flowNodeRef>Task_TB_Sys_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TB_Sys_ILP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TB_Sys_Enrolled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TB_Sys_Lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TB_Enrolled</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_TB_CatPlus" name="Nhận hồ sơ mới">
      <bpmn:messageEventDefinition id="MsgDef_TB_Start" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_TB_Sys_Create" name="Ghi nhận Student &amp; Journey" />
    <bpmn:userTask id="Task_TB_CSKH_Consult" name="Tư vấn &amp; nhập bộ 1–3 slot ưu tiên" />
    <bpmn:serviceTask id="Task_TB_Sys_ILP" name="Chạy ILP gợi ý Top cặp ghép tối ưu" />
    <bpmn:exclusiveGateway id="GW_TB_HasCandidate" name="Có phương án khả thi?" />
    <bpmn:userTask id="Task_TB_Mgr_Approve" name="Duyệt phương án gợi ý &amp; gửi gia sư" />
    <bpmn:intermediateCatchEvent id="Catch_TB_MgrRep" name="Nhận xác nhận gia sư">
      <bpmn:messageEventDefinition id="MsgDef_TB_TRep" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_TB_TutorOK" name="Gia sư xác nhận?" />
    <bpmn:userTask id="Task_TB_Mgr_Fallback" name="Chọn phương án dự phòng từ ILP" />
    <bpmn:serviceTask id="Task_TB_Sys_Enrolled" name="Tạo Class/Trial &amp; cập nhật ENROLLED" />
    <bpmn:userTask id="Task_TB_CSKH_Confirm" name="Báo lịch chốt cho phụ huynh" />
    <bpmn:endEvent id="End_TB_Enrolled" name="Nhập học thành công" />
    <bpmn:serviceTask id="Task_TB_Sys_Lost" name="Ghi CLOSED_LOST (thiếu năng lực)" />
    <bpmn:endEvent id="End_TB_Lost" name="Đóng hồ sơ thất bại" />

    <bpmn:sequenceFlow id="SF_TB1" sourceRef="Start_TB_CatPlus" targetRef="Task_TB_Sys_Create" />
    <bpmn:sequenceFlow id="SF_TB2" sourceRef="Task_TB_Sys_Create" targetRef="Task_TB_CSKH_Consult" />
    <bpmn:sequenceFlow id="SF_TB3" sourceRef="Task_TB_CSKH_Consult" targetRef="Task_TB_Sys_ILP" />
    <bpmn:sequenceFlow id="SF_TB4" sourceRef="Task_TB_Sys_ILP" targetRef="GW_TB_HasCandidate" />
    <bpmn:sequenceFlow id="SF_TB_CandYes" name="Có phương án" sourceRef="GW_TB_HasCandidate" targetRef="Task_TB_Mgr_Approve" />
    <bpmn:sequenceFlow id="SF_TB_CandNo" name="Không khả thi" sourceRef="GW_TB_HasCandidate" targetRef="Task_TB_Sys_Lost" />
    <bpmn:sequenceFlow id="SF_TB5" sourceRef="Task_TB_Mgr_Approve" targetRef="Catch_TB_MgrRep" />
    <bpmn:sequenceFlow id="SF_TB6" sourceRef="Catch_TB_MgrRep" targetRef="GW_TB_TutorOK" />
    <bpmn:sequenceFlow id="SF_TB_TutYes" name="Đồng ý" sourceRef="GW_TB_TutorOK" targetRef="Task_TB_Sys_Enrolled" />
    <bpmn:sequenceFlow id="SF_TB_TutNo" name="Bận đột xuất" sourceRef="GW_TB_TutorOK" targetRef="Task_TB_Mgr_Fallback" />
    <bpmn:sequenceFlow id="SF_TB_Back" sourceRef="Task_TB_Mgr_Fallback" targetRef="Task_TB_Mgr_Approve" />
    <bpmn:sequenceFlow id="SF_TB7" sourceRef="Task_TB_Sys_Enrolled" targetRef="Task_TB_CSKH_Confirm" />
    <bpmn:sequenceFlow id="SF_TB8" sourceRef="Task_TB_CSKH_Confirm" targetRef="End_TB_Enrolled" />
    <bpmn:sequenceFlow id="SF_TB_LostEnd" sourceRef="Task_TB_Sys_Lost" targetRef="End_TB_Lost" />

    <bpmn:textAnnotation id="Anno_TB_ILP">
      <bpmn:text>[Automate - L5] Tối ưu hóa ghép toàn cục thay cho dò tay FCFS, bảo toàn gia sư cho ca khó</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_TB1" sourceRef="Task_TB_Sys_ILP" targetRef="Anno_TB_ILP" />

    <bpmn:textAnnotation id="Anno_TB_Human">
      <bpmn:text>[Simplify] Con người chỉ duyệt &amp; xác nhận 1 vòng, loại bỏ vòng lặp hỏi lại phụ huynh</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_TB2" sourceRef="Task_TB_Mgr_Approve" targetRef="Anno_TB_Human" />
  </bpmn:process>

  <!-- POOL 3: Gia sư -->
  <bpmn:process id="Proc_Tutor_TB" isExecutable="false">
    <bpmn:startEvent id="Start_TB_Tutor" name="Nhận đề xuất lịch đã khớp sẵn">
      <bpmn:messageEventDefinition id="MsgDef_TB_TStart" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_TB_TutorRep" name="Xác nhận nhận lớp (1 chạm)" />
    <bpmn:endEvent id="End_TB_Tutor" name="Chốt lịch giảng dạy" />

    <bpmn:sequenceFlow id="SF_TBT1" sourceRef="Start_TB_Tutor" targetRef="Task_TB_TutorRep" />
    <bpmn:sequenceFlow id="SF_TBT2" sourceRef="Task_TB_TutorRep" targetRef="End_TB_Tutor" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_TOBE">
    <bpmndi:BPMNPlane id="Plane_TOBE" bpmnElement="Collab_TOBE">
      <bpmndi:BPMNShape id="DI_Part_Cust_TB" bpmnElement="Part_Customer_TB" isHorizontal="true">
        <dc:Bounds x="100" y="50" width="1140" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Part_CatPlus_TB" bpmnElement="Part_CatPlus_TB" isHorizontal="true">
        <dc:Bounds x="100" y="210" width="1140" height="470" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_TB_CSKH" bpmnElement="Lane_TB_CSKH" isHorizontal="true">
        <dc:Bounds x="130" y="210" width="1110" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_TB_Manager" bpmnElement="Lane_TB_Manager" isHorizontal="true">
        <dc:Bounds x="130" y="360" width="1110" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_TB_System" bpmnElement="Lane_TB_System" isHorizontal="true">
        <dc:Bounds x="130" y="520" width="1110" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Part_Tutor_TB" bpmnElement="Part_Tutor_TB" isHorizontal="true">
        <dc:Bounds x="100" y="700" width="1140" height="130" />
      </bpmndi:BPMNShape>

      <!-- Customer TB -->
      <bpmndi:BPMNShape id="DI_Start_TB_Cust" bpmnElement="Start_TB_Cust"><dc:Bounds x="160" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_TB_Reg" bpmnElement="Task_TB_Reg"><dc:Bounds x="230" y="80" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Catch_TB_CustCall" bpmnElement="Catch_TB_CustCall"><dc:Bounds x="410" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_TB_CustSlots" bpmnElement="Task_TB_CustSlots"><dc:Bounds x="490" y="80" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Catch_TB_CustConf" bpmnElement="Catch_TB_CustConf"><dc:Bounds x="960" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_TB_Cust" bpmnElement="End_TB_Cust"><dc:Bounds x="1070" y="102" width="36" height="36" /></bpmndi:BPMNShape>

      <!-- CatPlus TB -->
      <bpmndi:BPMNShape id="DI_Start_TB_CatPlus" bpmnElement="Start_TB_CatPlus"><dc:Bounds x="180" y="267" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_TB_Sys_Create" bpmnElement="Task_TB_Sys_Create"><dc:Bounds x="240" y="560" width="140" height="75" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_TB_CSKH_Consult" bpmnElement="Task_TB_CSKH_Consult"><dc:Bounds x="410" y="245" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_TB_Sys_ILP" bpmnElement="Task_TB_Sys_ILP"><dc:Bounds x="420" y="560" width="160" height="75" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_GW_TB_HasCandidate" bpmnElement="GW_TB_HasCandidate" isMarkerVisible="true"><dc:Bounds x="615" y="415" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_TB_Mgr_Approve" bpmnElement="Task_TB_Mgr_Approve"><dc:Bounds x="700" y="400" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Catch_TB_MgrRep" bpmnElement="Catch_TB_MgrRep"><dc:Bounds x="885" y="422" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_GW_TB_TutorOK" bpmnElement="GW_TB_TutorOK" isMarkerVisible="true"><dc:Bounds x="955" y="415" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_TB_Mgr_Fallback" bpmnElement="Task_TB_Mgr_Fallback"><dc:Bounds x="780" y="365" width="140" height="45" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_TB_Sys_Enrolled" bpmnElement="Task_TB_Sys_Enrolled"><dc:Bounds x="910" y="560" width="150" height="75" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_TB_CSKH_Confirm" bpmnElement="Task_TB_CSKH_Confirm"><dc:Bounds x="910" y="245" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_TB_Enrolled" bpmnElement="End_TB_Enrolled"><dc:Bounds x="1130" y="579" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_TB_Sys_Lost" bpmnElement="Task_TB_Sys_Lost"><dc:Bounds x="660" y="560" width="150" height="75" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_TB_Lost" bpmnElement="End_TB_Lost"><dc:Bounds x="1130" y="267" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DI_Anno_TB_ILP" bpmnElement="Anno_TB_ILP"><dc:Bounds x="180" y="480" width="210" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Anno_TB_Human" bpmnElement="Anno_TB_Human"><dc:Bounds x="640" y="250" width="200" height="50" /></bpmndi:BPMNShape>

      <!-- Tutor TB -->
      <bpmndi:BPMNShape id="DI_Start_TB_Tutor" bpmnElement="Start_TB_Tutor"><dc:Bounds x="710" y="747" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Task_TB_TutorRep" bpmnElement="Task_TB_TutorRep"><dc:Bounds x="790" y="725" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_TB_Tutor" bpmnElement="End_TB_Tutor"><dc:Bounds x="990" y="747" width="36" height="36" /></bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="DI_SF_TBC1" bpmnElement="SF_TBC1"><di:waypoint x="196" y="120" /><di:waypoint x="230" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TBC2" bpmnElement="SF_TBC2"><di:waypoint x="360" y="120" /><di:waypoint x="410" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TBC3" bpmnElement="SF_TBC3"><di:waypoint x="446" y="120" /><di:waypoint x="490" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TBC4" bpmnElement="SF_TBC4"><di:waypoint x="640" y="120" /><di:waypoint x="960" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TBC5" bpmnElement="SF_TBC5"><di:waypoint x="996" y="120" /><di:waypoint x="1070" y="120" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="DI_SF_TB1" bpmnElement="SF_TB1"><di:waypoint x="198" y="303" /><di:waypoint x="198" y="597" /><di:waypoint x="240" y="597" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB2" bpmnElement="SF_TB2"><di:waypoint x="380" y="597" /><di:waypoint x="395" y="597" /><di:waypoint x="395" y="285" /><di:waypoint x="410" y="285" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB3" bpmnElement="SF_TB3"><di:waypoint x="490" y="325" /><di:waypoint x="490" y="560" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB4" bpmnElement="SF_TB4"><di:waypoint x="580" y="597" /><di:waypoint x="600" y="597" /><di:waypoint x="600" y="440" /><di:waypoint x="615" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB_CandYes" bpmnElement="SF_TB_CandYes"><di:waypoint x="665" y="440" /><di:waypoint x="700" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB_CandNo" bpmnElement="SF_TB_CandNo"><di:waypoint x="640" y="465" /><di:waypoint x="640" y="597" /><di:waypoint x="660" y="597" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB5" bpmnElement="SF_TB5"><di:waypoint x="850" y="440" /><di:waypoint x="885" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB6" bpmnElement="SF_TB6"><di:waypoint x="921" y="440" /><di:waypoint x="955" y="440" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB_TutYes" bpmnElement="SF_TB_TutYes"><di:waypoint x="980" y="465" /><di:waypoint x="980" y="560" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB_TutNo" bpmnElement="SF_TB_TutNo"><di:waypoint x="980" y="415" /><di:waypoint x="980" y="387" /><di:waypoint x="920" y="387" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB_Back" bpmnElement="SF_TB_Back"><di:waypoint x="780" y="387" /><di:waypoint x="750" y="387" /><di:waypoint x="750" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB7" bpmnElement="SF_TB7"><di:waypoint x="1015" y="560" /><di:waypoint x="1015" y="325" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB8" bpmnElement="SF_TB8"><di:waypoint x="1060" y="285" /><di:waypoint x="1095" y="285" /><di:waypoint x="1095" y="597" /><di:waypoint x="1130" y="597" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TB_LostEnd" bpmnElement="SF_TB_LostEnd"><di:waypoint x="810" y="597" /><di:waypoint x="860" y="597" /><di:waypoint x="860" y="340" /><di:waypoint x="1148" y="340" /><di:waypoint x="1148" y="303" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="DI_Assoc_TB1" bpmnElement="Assoc_TB1"><di:waypoint x="420" y="565" /><di:waypoint x="390" y="520" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Assoc_TB2" bpmnElement="Assoc_TB2"><di:waypoint x="740" y="400" /><di:waypoint x="740" y="300" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="DI_SF_TBT1" bpmnElement="SF_TBT1"><di:waypoint x="746" y="765" /><di:waypoint x="790" y="765" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_SF_TBT2" bpmnElement="SF_TBT2"><di:waypoint x="940" y="765" /><di:waypoint x="990" y="765" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="DI_Msg_TB_Lead" bpmnElement="Msg_TB_Lead"><di:waypoint x="295" y="160" /><di:waypoint x="295" y="200" /><di:waypoint x="198" y="200" /><di:waypoint x="198" y="267" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Msg_TB_Call" bpmnElement="Msg_TB_Call"><di:waypoint x="440" y="245" /><di:waypoint x="440" y="195" /><di:waypoint x="428" y="195" /><di:waypoint x="428" y="138" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Msg_TB_Slots" bpmnElement="Msg_TB_Slots"><di:waypoint x="550" y="160" /><di:waypoint x="550" y="245" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Msg_TB_TutorAsk" bpmnElement="Msg_TB_TutorAsk"><di:waypoint x="728" y="480" /><di:waypoint x="728" y="747" /></bpmndi:BPMNEdge>
